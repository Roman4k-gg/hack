{
  "version": "1.0",
  "tools": [
    {
      "name": "get_my_profile",
      "description": "Профиль текущего пользователя: роль, команда, наставник.",
      "scope": "profile:self",
      "readOnly": true,
      "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false},
      "calls": {"method": "GET", "path": "/api/v1/me"}
    },
    {
      "name": "get_onboarding_plan",
      "description": "План адаптации стажёра: этапы, пункты, прогресс, следующий шаг.",
      "scope": "onboarding:plan:read",
      "readOnly": true,
      "inputSchema": {"type": "object", "properties": {}, "additionalProperties": false},
      "calls": {"method": "GET", "path": "/api/v1/onboarding/plan"}
    },
    {
      "name": "search_knowledge",
      "description": "Поиск по базе знаний команды с учётом прав. Возвращает цитаты со ссылками.",
      "scope": "kb:read*",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {"query": {"type": "string", "minLength": 2}, "limit": {"type": "integer", "maximum": 20}},
        "required": ["query"],
        "additionalProperties": false
      },
      "calls": {"method": "GET", "path": "/api/v1/kb/search"}
    },
    {
      "name": "preview_absence_request",
      "description": "Готовит черновик заявки на отгул и возвращает одноразовый токен подтверждения. Ничего не создаёт.",
      "scope": "absence:self",
      "readOnly": false,
      "destructive": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "date_from": {"type": "string", "format": "date"},
          "date_to": {"type": "string", "format": "date"},
          "absence_type": {"type": "string", "enum": ["vacation", "day_off", "sick_leave"]},
          "comment": {"type": "string", "maxLength": 500}
        },
        "required": ["date_from", "date_to", "absence_type"],
        "additionalProperties": false
      },
      "calls": {"method": "POST", "path": "/api/v1/requests/absence/preview"}
    },
    {
      "name": "create_absence_request",
      "description": "Создаёт заявку на отгул по подтверждённому preview.",
      "scope": "absence:self:write",
      "readOnly": false,
      "destructive": false,
      "requiresConfirmation": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "preview_id": {"type": "string", "format": "uuid"},
          "confirmation_token": {"type": "string"},
          "idempotency_key": {"type": "string", "format": "uuid"}
        },
        "required": ["preview_id", "confirmation_token", "idempotency_key"],
        "additionalProperties": false
      },
      "calls": {"method": "POST", "path": "/api/v1/requests/absence"}
    },
    {
      "name": "preview_access_bundle",
      "description": "Пакет доступов по роли: системы, причины и согласующие.",
      "scope": "access:self",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {"bundle": {"type": "string", "enum": ["intern", "mentor"]}},
        "required": ["bundle"],
        "additionalProperties": false
      },
      "calls": {"method": "POST", "path": "/api/v1/requests/access/preview"}
    },
    {
      "name": "create_access_requests",
      "description": "Создаёт заявки на доступы по подтверждённому пакету.",
      "scope": "access:self:write",
      "readOnly": false,
      "destructive": false,
      "requiresConfirmation": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "preview_id": {"type": "string", "format": "uuid"},
          "confirmation_token": {"type": "string"},
          "idempotency_key": {"type": "string", "format": "uuid"}
        },
        "required": ["preview_id", "confirmation_token", "idempotency_key"],
        "additionalProperties": false
      },
      "calls": {"method": "POST", "path": "/api/v1/requests/access"}
    },
    {
      "name": "get_request_status",
      "description": "Статус заявки и история её изменений.",
      "scope": "request:self",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {"request_id": {"type": "string", "format": "uuid"}},
        "required": ["request_id"],
        "additionalProperties": false
      },
      "calls": {"method": "GET", "path": "/api/v1/requests/{id}"}
    }
  ],
  "errors": ["FORBIDDEN", "NOT_FOUND", "VALIDATION_ERROR", "CONFLICT", "UPSTREAM_ERROR", "TIMEOUT"]
}
